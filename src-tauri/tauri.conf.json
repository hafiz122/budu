{
  "$schema": "./gen/schemas/desktop-schema.json",
  "productName": "Budu",
  "version": "0.1.1",
  "identifier": "io.budu.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bash scripts/build-steam-shim.sh && npm run dev --prefix ui",
    "beforeBuildCommand": "bash scripts/build-steam-shim.sh && npm run build --prefix ui"
  },
  "app": {
    "windows": [
      {
        "title": "Budu",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://cdn.akamai.steamstatic.com; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../compat-db": "compat-db",
      "../runtime/dist/steamwebhelper-shim.exe": "runtime/steamwebhelper-shim.exe",
      "../runtime/dist/wine-11.10": "runtime/wine-11.10"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "Games",
    "shortDescription": "Run Windows games on macOS",
    "longDescription": "Budu lets you run Windows games from your Steam library on Apple Silicon Macs using Wine and open graphics translation layers.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "entitlements": null
    }
  },
  "plugins": {}
}
